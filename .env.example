# Copy to .env and adjust as needed. All configuration goes through UTOPIA_-prefixed env vars.
UTOPIA_DATABASE_URL=postgres://utopia:utopia@localhost:1517/utopia
UTOPIA_BIND_ADDR=0.0.0.0:1516
# JWT signing key. Leave blank — one is auto-generated into the database on first start.
# Only fill this in to rotate the key, or to explicitly align multiple instances.
# UTOPIA_JWT_SECRET=
# Credential sealing key (encrypts LLM API keys, connection strings and source tokens before they reach the database; 32 bytes, hex or base64).
# Leave blank — one is generated to secret.key in the data directory on first start. The key never enters the database; back it up together with the data directory.
# UTOPIA_SECRET_KEY=
# Frontend build output directory (if present, the server hosts the SPA from it)
UTOPIA_WEB_DIST=web/dist
# Data directory: raw files (files/) and the full-text index (index/)
UTOPIA_DATA_DIR=data
# Force `Secure` on the session cookie. Leave blank — it's auto-determined from X-Forwarded-Proto when behind TLS.
# Only turn this on if your reverse proxy doesn't send that header.
# UTOPIA_COOKIE_SECURE=true
# Open registration; when false only the first user can register, others are admin-invited
UTOPIA_OPEN_REGISTRATION=true
# Database connection pool ceiling. Defaults to 32, aligned with the default worker concurrency.
# When the pool is smaller than concurrency, the symptom is requests slowing down, not an
# error anywhere saying "pool exhausted" — factor this in when you raise worker concurrency,
# and don't exceed Postgres's own max_connections (default 100).
# UTOPIA_DB_MAX_CONNECTIONS=32

# --- The following are read by docker-compose, not application config ---
# Database password. The default is only suitable for local development; change it for any public deployment.
# UTOPIA_DB_PASSWORD=utopia
# Database port mapping. Bound to loopback only by default, for local development connections; change this if the host port is taken.
# UTOPIA_DB_BIND=127.0.0.1:1517
# If you can't pull from Docker Hub, swap in any PG16+ image with pgvector
# UTOPIA_DB_IMAGE=pgvector/pgvector:pg16
# Pin a deployment to a specific version; defaults to latest
# UTOPIA_IMAGE=ghcr.io/deeplethe/utopia:0.1.0

# --- Restricted database role (optional, recommended for new deployments) ---
# Without this, the app runs as the database owner: that identity can DROP TRIGGER, which
# means it can bypass the ledger's immutability constraint. With this set, the app instead
# connects as utopia_app — business tables are read/written as normal, the ledger can only
# be appended to and read, never altered or deleted; migrations use a separate owner
# connection that's released once done.
#
# Note: this layer defends against application bugs, SQL injection and leaked connection
# strings — it does not defend against someone who can log into the server itself (psql
# inside the container is passwordless superuser). That's server access control's job.
#
# The init script creates the role on first `up`, so give all three together:
# UTOPIA_APP_DB_PASSWORD=replace with a random password
# UTOPIA_DATABASE_URL=postgres://utopia_app:the same password above@db:5432/utopia
# UTOPIA_MIGRATION_URL=postgres://utopia:${UTOPIA_DB_PASSWORD}@db:5432/utopia
#
# For a deployment whose data directory already exists, the init script won't run, so create
# the role manually once:
#   docker compose exec db psql -U utopia -d utopia \
#     -c "CREATE ROLE utopia_app LOGIN PASSWORD 'replace with a random password';"
# Then set the three variables above and restart; the migration will grant it permissions automatically.

# Optional Arcadia organization SSO. RS256 authorization code + PKCE.
# Create the local account first, then link the provider subject in /identity.
ARCADIA_OIDC_ISSUER=
ARCADIA_OIDC_CLIENT_ID=
ARCADIA_OIDC_CLIENT_SECRET=
ARCADIA_OIDC_REDIRECT_URI=
