+  --u-ring: #d6b56b;
+}
+.arc-brand {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin: 0 10px 36px;
+}
+.arc-brand a {
+  font-size: 29px;
+  letter-spacing: -0.03em !important;
