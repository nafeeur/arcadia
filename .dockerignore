# The build context only needs source. Without excluding target/ and node_modules/,
# just sending the context to the daemon takes minutes; node_modules would also
# overwrite the one produced by pnpm install inside the container (binary-incompatible
# if the host is Windows/macOS).
target/
**/node_modules/
.git/
.github/
data/
web/dist/
docs/
.claude/
.env
*.log
